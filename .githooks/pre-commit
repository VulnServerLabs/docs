#!/bin/sh
# VSL pre-commit hook: block commits that contain secrets (gitleaks).
# Enable once per clone:   git config core.hooksPath .githooks
# Details: .githooks/README.md
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so this commit was blocked." >&2
  echo "  Windows: winget install --id Gitleaks.Gitleaks   (then restart GitHub Desktop / your terminal)" >&2
  echo "  macOS:   brew install gitleaks" >&2
  echo "  Linux:   https://github.com/gitleaks/gitleaks/releases" >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose --exit-code 1 .
status=$?
if [ "$status" -ne 0 ]; then
  echo "" >&2
  echo "pre-commit: possible secret in the staged changes (values redacted above). Commit blocked." >&2
  echo "  Remove it and commit again. If it is a false positive, add its Fingerprint to .gitleaksignore." >&2
fi
exit "$status"
